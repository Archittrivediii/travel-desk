# Copy this file to .env and change the values.
DATABASE_URL=postgresql://traveldesk:change_me@localhost:5432/travel_desk
# Using Supabase instead? Replace the line above with the "Session pooler" string from the Connect button in your Supabase
# dashboard, with your real database password in place of [YOUR-PASSWORD]. It looks like this:
#   DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Use a password of letters and numbers only. Symbols such as @ : / # ? [ ] break the address.
# Optional database settings (the defaults are right for Supabase):
#   DATABASE_SSL=true            true or false. Default: on for Supabase, off for a local database.
#   DATABASE_SSL_CA=path\to\prod-ca-2021.crt   Supabase's certificate file (Project Settings > Database > SSL). Adds full certificate checking.
#   DATABASE_POOL_MAX=10         Most connections the server keeps open. Supabase's free plan allows only a few: lower this if you see "too many clients".
PORT=3000
# Set to true when the site is served over HTTPS, so the sign-in cookie is only sent encrypted.
COOKIE_SECURE=false
# Set to true only on a test copy. Enables the "Reset example data" link, which wipes all data.
ALLOW_RESET=false

# E-mail notifications (to the requester and the next approver). Leave SMTP_HOST empty to switch e-mail off.
# Port 587 uses STARTTLS automatically; for port 465 set SMTP_SECURE=true.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Travel Desk <it@your-company.com>
# Address people open from the e-mail (where Travel Desk runs).
APP_URL=http://localhost:3000
