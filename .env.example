# Copy this file to .env and change the values.
DATABASE_URL=postgresql://traveldesk:change_me@localhost:5432/travel_desk
PORT=3000
# Set to true when the site is served over HTTPS, so the sign-in cookie is only sent encrypted.
COOKIE_SECURE=false
# Set to true only on a test copy. Enables the "Reset example data" link, which wipes all data.
ALLOW_RESET=false

# E-mail notifications (to the requester and the next approver). Leave SMTP_HOST empty to switch e-mail off.
# Port 587 uses STARTTLS automatically; for port 465 set SMTP_SECURE=true.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Travel Desk <it@your-company.com>
# Address people open from the e-mail (where Travel Desk runs).
APP_URL=http://localhost:3000
